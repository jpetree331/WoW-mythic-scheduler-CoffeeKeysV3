# Local defaults need no credentials. Copy to .env (never commit .env).
DATABASE_URL=file:server/data/v3.db
# Vercel: replace DATABASE_URL with the Neon pooled PostgreSQL URL, including TLS parameters.
# DATABASE_URL=postgresql://USER:PASSWORD@YOUR-HOST-pooler.neon.tech/neondb?sslmode=require
HOST=127.0.0.1
PORT=8787
# Set a random token of at least 24 characters to enable organizers.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=
# Optional per-board tokens; use instead of a shared organizer token for multiple communities.
# ADMIN_TOKENS={"my-community":"a-long-random-token"}
# Remote libSQL: DATABASE_URL=libsql://your-database.turso.io
# DATABASE_AUTH_TOKEN=
# Only needed for a frontend hosted on a separate origin:
# ALLOWED_ORIGINS=https://your-frontend.example
# VITE_API_BASE=https://your-backend.example/api
