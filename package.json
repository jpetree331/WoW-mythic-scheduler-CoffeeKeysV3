{
  "name": "coffee-keys-v3",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write App.tsx index.tsx types.ts constants.ts vite.config.ts components services shared server/*.cjs tests/*.cjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "server": "node --env-file-if-exists=.env server/server.cjs",
    "start": "node --env-file-if-exists=.env server/server.cjs",
    "test": "node --test tests/*.test.cjs",
    "check": "npm run test && npm run build",
    "import:v2": "node --env-file-if-exists=.env server/import-v2.cjs"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "luxon": "^3.7.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.2",
    "vite": "^7.3.6"
  }
}
