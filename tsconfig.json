{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["vite/client", "node"]
  },
  "include": [
    "App.tsx",
    "index.tsx",
    "types.ts",
    "constants.ts",
    "components/**/*.tsx",
    "services/**/*.ts",
    "shared/*.d.ts",
    "vite.config.ts"
  ]
}
